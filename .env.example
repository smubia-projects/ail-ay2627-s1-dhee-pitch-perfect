# Server-side Gemini API key used by the LLM scorer (POST /api/score) and the
# coaching routes. Create one at https://aistudio.google.com/apikey and paste
# it below. Server-only — no NEXT_PUBLIC_ prefix, so it never reaches the
# browser. (.env* files are gitignored; only .env.example is committed.)
GEMINI_API_KEY=your_key_here

# Optional: Gemini model used by every AI route (scoring, question
# generation, rubric parsing).
# Defaults to gemini-3.7-flash when unset.
GEMINI_MODEL=gemini-3.7-flash
