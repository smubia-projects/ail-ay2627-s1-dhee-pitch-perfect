# Pitch Perfect API (server/, Cloud Run). Copy to .env for local dev (`npm run dev:server`).
# For deploys the whole file is uploaded as the DOTENV repo secret:
#   gh secret set DOTENV --repo smubia-projects/ail-ay2627-s1-dhee-pitch-perfect < .env
# Keep values on their own lines (no inline comments after a value).

# --- OpenRouter (required) ---
# Key from https://openrouter.ai/keys
API_KEY=your-openrouter-key-here
# Model for every AI route. It must accept PDF input (parse-rubric sends slides as a file part)
# and support JSON-schema structured output.
MODEL_NAME=gemini-3.5-flash-lite

# --- CORS (required in production) ---
# Comma-separated frontend origins, e.g. the Vercel URL. Empty = allow any origin (local dev only).
CORS_ORIGINS=http://localhost:3000

# --- Rate limiting (shared Upstash Redis; unset = limiting disabled) ---
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
# Fallback limits per IP per window; the central control sheet overrides them at runtime.
# One interview session scores up to 5 answers, so the score bucket is sized higher.
RATE_LIMIT_SCORE_MAX=25
RATE_LIMIT_GENERATE_QUESTIONS_MAX=5
RATE_LIMIT_EVALUATE_MAX=5
RATE_LIMIT_PARSE_RUBRIC_MAX=5
RATE_LIMIT_WINDOW_SECONDS=432000

# PORT is injected by Cloud Run (defaults to 8080 locally).

# --- Frontend (Next.js on Vercel) ---
# Set in the Vercel project, not in DOTENV. Locally, put it in .env.local if the API is not on
# http://localhost:8080 (the default when unset).
# NEXT_PUBLIC_API_BASE=https://ail-ay2627-s1-dhee-pitch-perfect-xxxxx.asia-southeast3.run.app
